      "criterion_number": 2,
      "criterion_category": "additional_symptoms",
      "criterion_text": "Mindestens drei bis vier Zusatzsymptome: Verminderte Konzentration, vermindertes Selbstwertgefühl, Schuldgefühle, pessimistische Zukunftsperspektive, Suizidgedanken/-handlungen, Schlafstörungen, verminderter Appetit",
      "required": true,
      "related_symptoms": ["Konzentrationsstörungen", "Selbstwertprobleme", "Schuldgefühle", "Hoffnungslosigkeit", "Suizidalität", "Insomnie", "Appetitverlust"],
      "clinical_markers": ["kann mich nicht konzentrieren", "wertlos", "schuldig", "aussichtslos", "Selbstmordgedanken", "kann nicht schlafen", "kein Hunger"]
    },
    {
