      "diagnosis_title": "Mittelgradige depressive Episode",
      "criterion_number": 1,
      "criterion_category": "main_symptoms",
      "criterion_text": "Mindestens zwei der drei Hauptsymptome: Depressive Stimmung, Interessenverlust/Freudlosigkeit, verminderter Antrieb/erhöhte Ermüdbarkeit",
      "required": true,
      "related_symptoms": ["depressive Stimmung", "Anhedonie", "Interessenverlust", "Antriebsmangel", "Ermüdbarkeit"],
      "clinical_markers": ["niedergeschlagen", "traurig", "lustlos", "erschöpft", "energielos"]
